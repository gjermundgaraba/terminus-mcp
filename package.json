{
  "name": "terminus-mcp",
  "version": "0.2.0",
  "description": "MCP server for creating and publishing content to Terminus",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "terminus",
    "trmnl"
  ],
  "license": "MIT",
  "author": "Gjermund Garaba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/terminus-mcp.git"
  },
  "bin": {
    "terminus-mcp": "./dist/index.mjs",
    "terminus-mcp-http": "./dist/http.mjs"
  },
  "files": [
    "dist",
    "docs/screen-authoring.md"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "prepare": "vp config",
    "prepublishOnly": "vp run ready",
    "ready": "vp check && vp test run && vp pack",
    "start": "node dist/index.mjs",
    "start:http": "node dist/http.mjs",
    "test": "vp test run",
    "verify:live": "tsx test/live.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@gjermundgaraba/effect-actions": "0.11.0",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
